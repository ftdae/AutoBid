{
  "manifest_version": 3,
  "name": "Auto Bid Assistant",
  "version": "0.1.0",
  "description": "Detect required job application fields, reuse cached answers, and fill reviewed drafts from selected profiles.",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "debugger", "identity", "alarms"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Auto Bid"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["hotkey-listener.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js", "panel-host.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "trigger-auto-bid": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "Ctrl+Q"
      },
      "description": "Analyze the current application form"
    }
  }
}
