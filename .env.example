PORT=7003
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=postgres://postgres:postgres@localhost:5433/autobid
DATABASE_POOL_MAX=50
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional legacy Gemini settings; current autofill routing does not use them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODELS=gemini-2.5-flash-lite

# Preferred Google Sheet bridge for local development.
# Use your deployed Apps Script Web App URL and the same extension secret.
GOOGLE_APPS_SCRIPT_WEB_APP_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Keeps the official script.google.com HTTPS host while routing around blocked
# Google IP ranges on local VMs. Set to script.google.com to use direct DNS.
GOOGLE_APPS_SCRIPT_CONNECT_HOST=www.google.com
GOOGLE_APPS_SCRIPT_TIMEOUT_MS=30000

# Alternative direct Google Sheets API bridge.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Microsoft Entra application for Outlook verification-message access.
# Register the Chrome redirect shown in Auto Bid as a Web redirect URI:
# https://EXTENSION_ID.chromiumapp.org/outlook
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_OUTLOOK_SCOPES=openid,profile,email,offline_access,User.Read,Mail.ReadWrite
